-# to be called if user is municipal admin
-# for reference - %adopt.haml.html

%h2
  = "Drain Administration"
%h4
  = @thing.display_name.titleize

= button_to 'Free', free_path(@thing), method: :put, class: "btn btn-primary btn-block"

= form_for :thing, :url => things_path, :method => :put, :html => {:id => "adoption_form"} do |f|
  = f.hidden_field "id"

  %fieldset.form-group
.break 
  = render partial: 'things/rename'
